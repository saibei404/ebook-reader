{
  "name": "moyu-reader",
  "version": "0.9.10",
  "description": "墨鱼阅读器 —— 本地优先的跨平台电子书阅读器（Electron + React + TypeScript）",
  "author": "saibei404",
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/run.cjs dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "shot": "npm run build && node scripts/run.cjs shot",
    "dist:portable": "electron-vite build && electron-builder --win portable -c.directories.output=release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --no-file-parallelism",
    "push": "bash scripts/push.sh"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@number-flow/react": "^0.6.2",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "idb": "^8.0.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "word-extractor": "^1.0.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.moyu.reader",
    "productName": "墨鱼阅读器",
    "copyright": "Copyright © 2026 saibei404",
    "asar": true,
    "directories": {
      "output": "D:/moyu-builds"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "resources/tray-icon.png",
      "!out/renderer/**/*.map"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saibei404/ebook-reader.git"
  },
  "homepage": "https://github.com/saibei404/ebook-reader#readme",
  "bugs": {
    "url": "https://github.com/saibei404/ebook-reader/issues"
  }
}
